# Database connection URL (PostgreSQL for dev/prod, SQLite for local/test)
DATABASE_URL=postgresql://user:password@localhost:5432/recallos

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-32-byte-hex-secret
JWT_EXPIRE_MINUTES=1440

# LLM Integration (Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Limit in MB
MAX_UPLOAD_MB=10

# Daily Card Review Limit
DAILY_CARD_LIMIT=50

# Feature Flags
ENABLE_DUEL=true
