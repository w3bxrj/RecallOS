# Application Environment ("development" or "production")
ENV=development

# Database connection URL
# For local dev / testing: sqlite:///./recallos_dev.db
# For production (Neon PostgreSQL): postgresql://user:password@ep-xyz.singapore.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/recallos

# JWT Authentication (must be at least 32 characters in production)
JWT_SECRET=change-this-to-a-secure-random-32-byte-hex-secret
JWT_EXPIRE_MINUTES=1440

# LLM Integration (Google Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins (comma-separated, no trailing slashes, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Limit in MB
MAX_UPLOAD_MB=10

# Maximum pages to process for scanned PDF vision mode (default: 32 pages / 8 chunks)
MAX_VISION_PAGES=32

# Daily Card Review Limit
DAILY_CARD_LIMIT=50

# Feature Flags
ENABLE_DUEL=true
